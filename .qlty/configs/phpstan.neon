parameters:
    # This package ships its own config directory. Left unset, the env() check
    # resolves the path from a booted application instead and reports every
    # call in it.
    configDirectories:
        - %currentWorkingDirectory%/config

    # The config is staged outside the repository when qlty runs it, and the
    # tool sandbox has no project autoloader, so the package's own classes are
    # found by scanning its directories.
    scanDirectories:
        - %currentWorkingDirectory%/src
        - %currentWorkingDirectory%/testing
        - %currentWorkingDirectory%/tests

    # The sandbox installs the analysis stack, not the project, so the package's
    # classes are autoloaded here for larastan, which instantiates models.
    bootstrapFiles:
        - %currentWorkingDirectory%/.qlty/configs/autoload.php

    paths:
        - src
        - testing
        - tests

    # Analyse against the supported PHP range (composer.json and the CI matrix)
    # rather than the PHP running PHPStan. Version-gated rules are evaluated at
    # the minimum, so features only valid on newer PHP, such as #[\Override] on
    # properties (PHP 8.5+), are not demanded of code that must load on PHP 8.3;
    # the trade-off is that PHP 8.4/8.5-only deprecation checks do not run.
    phpVersion:
        min: 80300
        max: 80599

    # The Cacheable trait's collaborators are assigned by bootCacheable(),
    # which Repository::bootConcerns() invokes from the constructor, so the
    # properties are initialized during construction even though the dynamic
    # dispatch is invisible to the uninitialized-property check. The check
    # reports against the consuming class, so scope the ignore to the test
    # fixtures that use the trait. The leading wildcard is required because the
    # config is staged outside the repository when it runs.
    ignoreErrors:
        # The package supports Laravel 12 alongside 13, so its floor sits below
        # the 13.2 that introduced the model attributes. The legacy form is the
        # only form available until the floor moves, which dropping 12 would
        # mean. The enforcement rule itself stays on.
        -
            identifier: sineMaculaLaravel.modelAttributeLaggingFloor
            paths:
                - '*/tests/Support/Models/*'
        -
            identifier: property.uninitialized
            paths:
                - '*/tests/Support/Repositories/*'
